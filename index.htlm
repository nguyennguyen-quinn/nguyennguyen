    <!-- Contact -->
    <section id="contact" class="scroll-mt-28 bg-[#0c1d36]/55 py-24 md:py-28">
      <div class="section-shell">
        <div class="mx-auto max-w-3xl">
          <p class="mono text-center text-sm text-cyan">06. WHAT'S NEXT?</p>
