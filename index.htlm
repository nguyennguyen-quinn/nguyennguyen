    <!-- Certifications and education -->
    <section id="certifications" class="section-shell scroll-mt-28 py-24 md:py-28">
      <h2 class="section-heading"><span>05.</span> Certifications &amp; Education</h2>
      <div class="grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-4">
