              </label>
              <label class="mb-4 block">
                <span class="mb-2 block text-xs font-medium text-[#d6def2]">Email</span>
                <input class="w-full rounded-md border border-white/10 bg-[#0a192f]/80 px-3 py-3 text-sm text-[#e6f1ff] placeholder:text-slate/70" type="email" name="email" autocomplete="email" placeholder="you@company.com" required>
              </label>
              <label class="mb-5 block">
                <span class="mb-2 block text-xs font-medium text-[#d6def2]">Message</span>
                <textarea class="w-full resize-y rounded-md border border-white/10 bg-[#0a192f]/80 px-3 py-3 text-sm text-[#e6f1ff] placeholder:text-slate/70" name="message" rows="4" placeholder="Tell me a little about your project..." required></textarea>
              </label>
              <button class="primary-button w-full" type="submit">Prepare email <span aria-hidden="true">↗</span></button>
              <p id="form-status" class="mt-3 min-h-5 text-xs text-cyan" aria-live="polite">This form opens your email app; it does not send data to a server.</p>
