  <footer class="border-t border-white/[0.06] py-7">
    <div class="section-shell flex flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-left">
      <p class="mono text-[10px] text-slate">Designed &amp; built by Kim Nguyen</p>
      <p class="text-xs text-slate">© <span id="current-year"></span> Kim Nguyen · SAP Technical Consultant</p>
      <a class="mono text-[10px] text-slate transition hover:text-cyan" href="#home">Back to top ↑</a>
    </div>
  </footer>

  <script>
    // Mobile navigation: keep the menu keyboard- and screen-reader-friendly.
    const menuToggle = document.getElementById("menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const menuIcon = document.getElementById("menu-icon");

    menuToggle.addEventListener("click", () => {
      const isOpen = mobileNav.dataset.open === "true";
      mobileNav.dataset.open = String(!isOpen);
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
      menuIcon.innerHTML = isOpen
        ? '<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>'
        : '<path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>';
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.dataset.open = "false";
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open menu");
        menuIcon.innerHTML = '<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>';
      });
    });

    // Filter the project cards without reloading the page.
    const filterButtons = document.querySelectorAll("[data-filter]");
    const projectCards = document.querySelectorAll(".project-card");
    const projectEmpty = document.getElementById("project-empty");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.dataset.filter;
        let visibleCount = 0;
        filterButtons.forEach((filter) => filter.setAttribute("aria-pressed", String(filter === button)));
        projectCards.forEach((card) => {
          const visible = selected === "all" || card.dataset.category === selected;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        projectEmpty.classList.toggle("hidden", visibleCount > 0);
      });
    });

    // Progressive reveal; content remains visible if IntersectionObserver is unavailable.
    const revealItems = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    // Generate a plain-text CV locally so the single-file page needs no backend.
    const cvText = [
      "NGUYEN THI KIM NGUYEN",
      "Senior SAP Technical Consultant | ABAP & S/4HANA Migration Specialist",
      "Ho Chi Minh City, Vietnam | +84-935-868-595 | nguyenntk0703@gmail.com",
      "",
      "PROFILE",
      "SAP technical consultant with 6+ years of experience in ABAP, S/4HANA transformation and system integration. Contributed to 18+ enterprise projects across Vietnam, Singapore, Thailand, Malaysia and Japan.",
      "",
      "EXPERIENCE",
      "Deloitte Consulting SEA | SAP Technical Consultant | 12/2020 — Present",
      "Technical solution design, strategic assessment, recommendations, resource estimates and SAP S/4HANA transformation and upgrade roadmaps.",
      "",
      "FPT Software | SAP ABAP Developer / Integration Developer | 10/2017 — 11/2020",
      "Complex ABAP development and SAP / non-SAP integration for Japan and Southeast Asia delivery.",
      "",
      "CORE SKILLS",
      "SAP ECC 6.0, S/4HANA 1809–2022, RISE, SFIN, CVI, ABAP Objects, FRICEW, BADI, User Exits, SPAU/SPDD, SAP CPI, PI/PO, HCI, IDoc, RFC, REST APIs, SD, MM, EWM, FI/CO, TM, IBP, BCM.",
      "",
      "CERTIFICATIONS",
      "SAP Certified Development Specialist — ABAP for SAP HANA 2.0",
      "SAP Certified Development Associate — ABAP with SAP NetWeaver 7.40",
      "SAP Certified Application Associate — SAP S/4HANA Sales 1809 Upskilling",
      "",
      "EDUCATION & LANGUAGES",
      "B.Sc. Computer Science, Ton Duc Thang University (2018)",
      "Vietnamese (Native) | English (IELTS 6.5, B2)"
    ].join("\n");
    const downloadStatus = document.getElementById("download-status");
    document.querySelectorAll("[data-download-cv]").forEach((button) => {
      button.addEventListener("click", () => {
        const blob = new Blob([cvText], { type: "text/plain;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "Nguyen-Thi-Kim-Nguyen-CV.txt";
        document.body.appendChild(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        downloadStatus.textContent = "Your CV has been prepared for download.";
      });
    });

    // A mailto form works without a backend and clearly keeps submission on the user's device.
    document.getElementById("contact-form").addEventListener("submit", (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const subject = encodeURIComponent(`Portfolio enquiry from ${data.get("name")}`);
      const body = encodeURIComponent(`Name: ${data.get("name")}\nEmail: ${data.get("email")}\n\n${data.get("message")}`);
      document.getElementById("form-status").textContent = "Opening your email application to complete the message…";
      window.location.href = `mailto:nguyenntk0703@gmail.com?subject=${subject}&body=${body}`;
    });

    document.getElementById("current-year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
