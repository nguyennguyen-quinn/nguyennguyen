<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a192f">
  <meta name="description" content="Portfolio of Nguyen Thi Kim Nguyen, Senior SAP Technical Consultant specializing in ABAP, S/4HANA transformation and system integration.">
  <title>Kim Nguyen | SAP Technical Consultant</title>

  <!-- Tailwind CDN keeps this portfolio self-contained in one HTML file. -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: "#0a192f",
            panel: "#112240",
            slate: "#8892b0",
            accent: "#64a8ff",
            cyan: "#64ffda"
          },
          fontFamily: {
            sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
            mono: ["SFMono-Regular", "Consolas", "monospace"]
          }
        }
      }
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;
      --navy: #0a192f;
      --panel: #112240;
      --slate: #8892b0;
      --light: #ccd6f6;
      --accent: #64a8ff;
      --cyan: #64ffda;
    }

    * { box-sizing: border-box; }
    html { scroll-padding-top: 88px; }
    body {
      margin: 0;
      background: var(--navy);
      color: var(--slate);
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: rgba(100, 255, 218, 0.22); color: var(--light); }
    a, button { -webkit-tap-highlight-color: transparent; }
    a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 4px;
    }
    .mono { font-family: "DM Mono", SFMono-Regular, Consolas, monospace; }
    .section-shell { width: min(100% - 3rem, 1100px); margin-inline: auto; }
    .section-heading {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 42px;
      color: #e6f1ff;
      font-size: clamp(1.45rem, 3vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.035em;
    }
    .section-heading span {
      color: var(--cyan);
      font: 500 0.9rem "DM Mono", monospace;
    }
    .section-heading::after {
      width: min(240px, 30vw);
      height: 1px;
      content: "";
      background: rgba(136, 146, 176, 0.22);
    }
    .glass {
      border: 1px solid rgba(136, 146, 176, 0.13);
      background: linear-gradient(145deg, rgba(17, 34, 64, 0.96), rgba(15, 31, 57, 0.88));
      box-shadow: 0 18px 48px rgba(2, 12, 27, 0.2);
      backdrop-filter: blur(14px);
    }
    .nav-link { transition: color 180ms ease; }
    .nav-link:hover, .nav-link[aria-current="location"] { color: var(--cyan); }
    .primary-button, .outline-button {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: 1px solid var(--cyan);
      border-radius: 6px;
      padding: 0 17px;
      color: var(--cyan);
      font-size: 0.85rem;
      font-weight: 600;
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }
    .primary-button { background: rgba(100, 255, 218, 0.08); }
    .primary-button:hover, .outline-button:hover {
      transform: translateY(-2px);
      background: rgba(100, 255, 218, 0.13);
      box-shadow: 0 10px 24px rgba(100, 255, 218, 0.08);
    }
    .outline-button { border-color: rgba(100, 168, 255, 0.6); color: #a9ccff; }
    .outline-button:hover { background: rgba(100, 168, 255, 0.1); }
    .skill-chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(100, 168, 255, 0.16);
      border-radius: 5px;
      background: rgba(100, 168, 255, 0.055);
      padding: 7px 10px;
      color: #bdc9e6;
      font: 0.76rem "DM Mono", monospace;
      transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
    }
    .skill-chip:hover { transform: translateY(-2px); border-color: rgba(100, 255, 218, 0.45); color: var(--cyan); }
    .project-card {
      display: flex;
      min-height: 100%;
      flex-direction: column;
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }
    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(100, 255, 218, 0.3);
      box-shadow: 0 22px 50px rgba(2, 12, 27, 0.34);
    }
    .filter-button {
      border: 1px solid rgba(136, 146, 176, 0.22);
      border-radius: 999px;
      padding: 8px 13px;
      color: #aab5d0;
      font-size: 0.77rem;
      transition: all 180ms ease;
    }
    .filter-button:hover, .filter-button[aria-pressed="true"] {
      border-color: rgba(100, 255, 218, 0.55);
      background: rgba(100, 255, 218, 0.08);
      color: var(--cyan);
    }
    .project-card[hidden] { display: none; }
    .timeline-item { position: relative; }
    .timeline-item::before {
      position: absolute;
      top: 8px;
      left: -25px;
      width: 9px;
      height: 9px;
      border: 2px solid var(--cyan);
      border-radius: 50%;
      background: var(--navy);
      content: "";
    }
    .reveal { opacity: 0; transform: translateY(14px); transition: opacity 550ms ease, transform 550ms ease; }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }
    .hero-grid {
      background-image: linear-gradient(rgba(100, 168, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(100, 168, 255, 0.035) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
    }
    .portrait-orbit { animation: orbit 28s linear infinite; transform-origin: center; }
    @keyframes orbit { to { transform: rotate(360deg); } }
    @media (max-width: 767px) {
      .section-shell { width: min(100% - 2rem, 1100px); }
      .section-heading { margin-bottom: 30px; }
      #mobile-nav[data-open="false"] { display: none; }
      #mobile-nav[data-open="true"] { display: flex; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>

<body class="overflow-x-hidden">
  <!-- Sticky navigation -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-[#0a192f]/90 backdrop-blur-xl">
    <div class="section-shell flex h-[76px] items-center justify-between">
      <a href="#home" class="group leading-tight" aria-label="Kim Nguyen, home">
        <span class="block text-sm font-bold tracking-wide text-[#e6f1ff]">Kim Nguyen</span>
        <span class="mono mt-1 block text-[10px] text-slate">SAP Technical Consultant</span>
      </a>

      <nav class="hidden items-center gap-5 lg:flex" aria-label="Main navigation">
        <a class="nav-link text-xs text-slate" href="#about">About</a>
        <a class="nav-link text-xs text-slate" href="#skills">Core Skills</a>
        <a class="nav-link text-xs text-slate" href="#experience">Experience</a>
        <a class="nav-link text-xs text-slate" href="#projects">Featured Projects</a>
        <a class="nav-link text-xs text-slate" href="#certifications">Certifications</a>
        <a class="nav-link text-xs text-slate" href="#contact">Contact</a>
      </nav>

      <div class="hidden items-center gap-2 sm:flex">
        <button class="outline-button min-h-[40px] px-3 text-xs" type="button" data-download-cv>Download CV</button>
        <a class="primary-button min-h-[40px] px-3 text-xs" href="#contact">Get in Touch</a>
      </div>

      <button id="menu-toggle" class="grid h-10 w-10 place-items-center rounded-md border border-white/10 text-[#ccd6f6] lg:hidden" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg id="menu-icon" width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <nav id="mobile-nav" data-open="false" class="absolute inset-x-0 top-[76px] hidden flex-col gap-1 border-b border-white/10 bg-[#0a192f]/[0.98] px-6 pb-5 pt-3 shadow-2xl lg:hidden" aria-label="Mobile navigation">
      <a class="nav-link py-2 text-sm text-slate" href="#about">About</a>
      <a class="nav-link py-2 text-sm text-slate" href="#skills">Core Skills</a>
      <a class="nav-link py-2 text-sm text-slate" href="#experience">Experience</a>
      <a class="nav-link py-2 text-sm text-slate" href="#projects">Featured Projects</a>
      <a class="nav-link py-2 text-sm text-slate" href="#certifications">Certifications</a>
      <a class="nav-link py-2 text-sm text-slate" href="#contact">Contact</a>
      <div class="mt-3 flex gap-2 sm:hidden">
        <button class="outline-button flex-1 text-xs" type="button" data-download-cv>Download CV</button>
        <a class="primary-button flex-1 text-xs" href="#contact">Get in Touch</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section id="home" class="relative flex min-h-[780px] scroll-mt-20 items-center overflow-hidden pb-20 pt-32 md:min-h-[850px]">
      <div class="hero-grid pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-36 top-36 h-[430px] w-[430px] rounded-full bg-blue-500/[0.08] blur-[110px]" aria-hidden="true"></div>
      <div class="section-shell relative z-10 grid items-center gap-12 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="max-w-3xl">
          <p class="mono mb-5 text-sm text-cyan">SAP · ABAP · S/4HANA</p>
          <h1 class="text-4xl font-extrabold leading-[1.12] tracking-[-0.055em] text-[#e6f1ff] sm:text-5xl md:text-6xl lg:text-[4.25rem]">
            Nguyen Thi<br class="hidden sm:block"> Kim Nguyen<span class="text-cyan">.</span>
          </h1>
          <h2 class="mt-6 max-w-2xl text-lg font-medium leading-relaxed text-[#aebbd7] sm:text-xl">
            Senior SAP Technical Consultant <span class="text-slate">/</span><br class="hidden sm:block">
            <span class="text-accent">ABAP &amp; S/4HANA Migration Specialist</span>
          </h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-slate sm:text-base sm:leading-8">
            Hơn 6 năm kinh nghiệm trong tư vấn CNTT chuyên sâu về SAP ABAP, S/4HANA Transformation và System Integration. Đã tham gia hơn 18 dự án quy mô lớn tại Việt Nam, Singapore, Thái Lan, Malaysia và Nhật Bản, đồng hành cùng các đội ngũ Deloitte và FPT Software.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="primary-button" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="outline-button" href="#contact">Get in Touch</a>
            <button class="outline-button" type="button" data-download-cv>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              Download CV
            </button>
          </div>
          <p id="download-status" class="mt-3 min-h-5 text-xs text-cyan" aria-live="polite"></p>
        </div>

        <div class="relative mx-auto hidden h-[340px] w-[340px] items-center justify-center md:flex lg:h-[390px] lg:w-[390px]" aria-label="SAP technical consulting illustration">
          <div class="absolute inset-5 rounded-full border border-blue-300/10"></div>
          <div class="portrait-orbit absolute inset-0 rounded-full border border-dashed border-cyan/20"></div>
          <div class="absolute inset-12 rounded-full bg-gradient-to-br from-blue-400/10 via-cyan/[0.04] to-transparent blur-sm"></div>
          <div class="glass relative grid h-48 w-48 place-items-center rounded-[2rem] border-cyan/20 text-center shadow-[0_0_80px_rgba(100,168,255,0.12)] lg:h-56 lg:w-56">
            <div>
              <span class="mono block text-5xl font-medium tracking-[-0.08em] text-cyan">SAP</span>
              <span class="mono mt-3 block text-[10px] uppercase tracking-[0.2em] text-slate">Solutions that scale</span>
            </div>
          </div>
          <span class="mono absolute left-1 top-20 rounded-md border border-white/10 bg-panel/90 px-3 py-2 text-[10px] text-accent">ABAP</span>
          <span class="mono absolute right-0 top-28 rounded-md border border-white/10 bg-panel/90 px-3 py-2 text-[10px] text-cyan">S/4HANA</span>
          <span class="mono absolute bottom-20 left-0 rounded-md border border-white/10 bg-panel/90 px-3 py-2 text-[10px] text-[#d8b4fe]">Integration</span>
          <span class="mono absolute bottom-12 right-5 rounded-md border border-white/10 bg-panel/90 px-3 py-2 text-[10px] text-[#f3c98b]">Cloud</span>
        </div>
      </div>

      <div class="section-shell absolute bottom-0 left-1/2 z-10 grid -translate-x-1/2 grid-cols-2 gap-3 pb-7 sm:grid-cols-4">
        <article class="glass rounded-lg p-4 sm:p-5">
          <p class="text-2xl font-bold tracking-tight text-[#e6f1ff]">6<span class="text-cyan">+</span></p>
          <p class="mt-1 text-[11px] leading-5 text-slate sm:text-xs">Years in SAP enterprise</p>
        </article>
        <article class="glass rounded-lg p-4 sm:p-5">
          <p class="text-2xl font-bold tracking-tight text-[#e6f1ff]">18<span class="text-cyan">+</span></p>
          <p class="mt-1 text-[11px] leading-5 text-slate sm:text-xs">Transformation, migration, rollout &amp; AMS projects</p>
        </article>
        <article class="glass rounded-lg p-4 sm:p-5">
          <p class="text-2xl font-bold tracking-tight text-[#e6f1ff]">5</p>
          <p class="mt-1 text-[11px] leading-5 text-slate sm:text-xs">Countries delivered across</p>
        </article>
        <article class="glass rounded-lg p-4 sm:p-5">
          <p class="text-2xl font-bold tracking-tight text-[#e6f1ff]">3</p>
          <p class="mt-1 text-[11px] leading-5 text-slate sm:text-xs">SAP international certifications</p>
        </article>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="section-shell scroll-mt-28 py-24 md:py-28">
      <h2 class="section-heading"><span>01.</span> About</h2>
      <div class="grid gap-8 md:grid-cols-[1.5fr_0.8fr] md:gap-14">
        <div class="space-y-4 text-sm leading-7 text-slate sm:text-base sm:leading-8">
          <p>
            I am a SAP technical consultant focused on helping enterprise teams modernize, connect and run critical business systems. My work spans the full delivery lifecycle—from technical discovery and architecture through build, migration, testing and post-go-live support.
          </p>
          <p>
            Across consulting and delivery teams at <span class="text-cyan">Deloitte Consulting SEA</span> and <span class="text-cyan">FPT Software</span>, I have worked with stakeholders across Southeast Asia and Japan, translating complex business needs into practical SAP solutions.
          </p>
          <p>
            My core focus is S/4HANA transformation, ABAP engineering, system integration and reliable delivery across distributed, multi-country programs.
          </p>
        </div>
        <aside class="glass rounded-xl p-6">
          <p class="mono text-xs text-cyan">AT A GLANCE</p>
          <dl class="mt-5 space-y-4 text-sm">
            <div class="flex justify-between gap-5 border-b border-white/[0.07] pb-3"><dt class="text-slate">Based in</dt><dd class="text-right text-[#d6def2]">Ho Chi Minh City, Vietnam</dd></div>
            <div class="flex justify-between gap-5 border-b border-white/[0.07] pb-3"><dt class="text-slate">Delivery markets</dt><dd class="text-right text-[#d6def2]">VN · SG · TH · MY · JP</dd></div>
            <div class="flex justify-between gap-5"><dt class="text-slate">Languages</dt><dd class="text-right text-[#d6def2]">Vietnamese · English (B2)</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="scroll-mt-28 bg-[#0c1d36]/55 py-24 md:py-28">
      <div class="section-shell">
        <h2 class="section-heading"><span>02.</span> Core Skills</h2>
        <p class="mb-9 max-w-2xl text-sm leading-7 text-slate">A cross-functional SAP toolkit for transformation programs, modern extensions and dependable operations.</p>
        <div class="grid gap-4 md:grid-cols-2">
          <article class="glass rounded-xl p-6">
            <h3 class="font-semibold text-[#e6f1ff]">SAP Core &amp; ERP</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="skill-chip">SAP ECC 6.0</span><span class="skill-chip">S/4HANA On-Premise</span><span class="skill-chip">S/4HANA Cloud / RISE</span><span class="skill-chip">1809–2022</span><span class="skill-chip">SFIN Migration</span><span class="skill-chip">CVI Conversion</span>
            </div>
          </article>
          <article class="glass rounded-xl p-6">
            <h3 class="font-semibold text-[#e6f1ff]">Development &amp; Extensions</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="skill-chip">SAP ABAP</span><span class="skill-chip">ABAP Objects</span><span class="skill-chip">FRICEW</span><span class="skill-chip">BADI</span><span class="skill-chip">User Exits</span><span class="skill-chip">Enhancements</span><span class="skill-chip">SPAU / SPDD</span><span class="skill-chip">Performance Tuning</span>
            </div>
          </article>
          <article class="glass rounded-xl p-6">
            <h3 class="font-semibold text-[#e6f1ff]">Integration &amp; Interfaces</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="skill-chip">SAP CPI</span><span class="skill-chip">SAP PI/PO</span><span class="skill-chip">HCI</span><span class="skill-chip">IDoc</span><span class="skill-chip">RFC</span><span class="skill-chip">RESTful API</span><span class="skill-chip">e-Invoice Integration</span>
            </div>
          </article>
          <article class="glass rounded-xl p-6">
            <h3 class="font-semibold text-[#e6f1ff]">SAP Modules In-depth</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="skill-chip">SD</span><span class="skill-chip">MM</span><span class="skill-chip">EWM</span><span class="skill-chip">FI/CO</span><span class="skill-chip">TM</span><span class="skill-chip">IBP</span><span class="skill-chip">BCM</span>
            </div>
          </article>
          <article class="glass rounded-xl p-6 md:col-span-2">
            <h3 class="font-semibold text-[#e6f1ff]">Methods &amp; Delivery</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="skill-chip">Solution Architecture</span><span class="skill-chip">Technical Specification</span><span class="skill-chip">System Remediation</span><span class="skill-chip">Retrofitting</span><span class="skill-chip">Unit Testing</span><span class="skill-chip">Integration Testing</span><span class="skill-chip">UAT</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="section-shell scroll-mt-28 py-24 md:py-28">
      <h2 class="section-heading"><span>03.</span> Experience</h2>
      <div class="ml-3 max-w-3xl border-l border-white/10 pl-7">
        <article class="timeline-item reveal pb-12">
          <p class="mono text-xs text-cyan">12/2020 — Present</p>
          <h3 class="mt-3 text-xl font-semibold text-[#e6f1ff]">SAP Technical Consultant</h3>
          <p class="mt-1 text-sm text-accent">Deloitte Consulting SEA</p>
          <p class="mt-4 text-sm leading-7 text-slate">
            Design technical solutions, assess long-term strategic needs and recommend SAP S/4HANA transformation and upgrade approaches. Contribute to resource estimates, delivery roadmaps and solution decisions for enterprise programs, aligning technical delivery with business goals.
          </p>
          <div class="mt-4 flex flex-wrap gap-2"><span class="skill-chip">S/4HANA Transformation</span><span class="skill-chip">Solution Design</span><span class="skill-chip">Technical Roadmap</span></div>
        </article>
        <article class="timeline-item reveal">
          <p class="mono text-xs text-cyan">10/2017 — 11/2020</p>
          <h3 class="mt-3 text-xl font-semibold text-[#e6f1ff]">SAP ABAP Developer / Integration Developer</h3>
          <p class="mt-1 text-sm text-accent">FPT Software</p>
          <p class="mt-4 text-sm leading-7 text-slate">
            Built complex ABAP programs and designed integrations between SAP and non-SAP platforms. Contributed to delivery for Japanese and Southeast Asian markets, working across development, interface testing and implementation activities.
          </p>
          <div class="mt-4 flex flex-wrap gap-2"><span class="skill-chip">ABAP</span><span class="skill-chip">System Integration</span><span class="skill-chip">Japan &amp; SEA</span></div>
        </article>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="scroll-mt-28 bg-[#0c1d36]/55 py-24 md:py-28">
      <div class="section-shell">
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div>
            <h2 class="section-heading mb-3"><span>04.</span> Featured Projects</h2>
            <p class="max-w-xl text-sm leading-6 text-slate">Selected transformation, integration and rollout engagements across Asia-Pacific.</p>
          </div>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects">
            <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
            <button class="filter-button" type="button" data-filter="migration" aria-pressed="false">S/4HANA Migration</button>
            <button class="filter-button" type="button" data-filter="integration" aria-pressed="false">Integration</button>
            <button class="filter-button" type="button" data-filter="ams" aria-pressed="false">AMS &amp; Rollout</button>
          </div>
        </div>

        <div id="project-grid" class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class="project-card glass rounded-xl p-6" data-category="migration">
            <div class="flex items-start justify-between gap-3"><span class="mono text-xs text-cyan">2023 — Present</span><span class="text-lg text-slate" aria-hidden="true">↗</span></div>
            <h3 class="mt-5 text-lg font-semibold leading-snug text-[#e6f1ff]">Sime Darby Plantation Berhad</h3>
            <p class="mt-1 text-xs text-slate">Malaysia · S/4HANA Transformation</p>
